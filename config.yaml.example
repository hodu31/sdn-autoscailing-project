# config.yaml 템플릿 파일
# 실제 사용시 config.yaml로 복사하여 사용하세요
# cp config.yaml.example config.yaml

ROOT_PASSWORD: your_root_password_here
ADMIN_PASSWORD: your_admin_password_here
VAGRANT_PASSWORD: your_vagrant_password_here

NETWORK_SUBNET: 192.168.100
MGMT_IP: 192.168.100.10
SDN_IP: 192.168.100.20
APP1_IP: 192.168.100.30

GRAFANA_ADMIN_USER: admin
GRAFANA_ADMIN_PASSWORD: your_grafana_password_here
PROMETHEUS_RETENTION: 200h

SDN_USER: sdn
OPENFLOW_PORT: 6653
SDN_API_PORT: 8080

MGMT_MEMORY: 2048
SDN_MEMORY: 1024
APP_MEMORY: 2048
